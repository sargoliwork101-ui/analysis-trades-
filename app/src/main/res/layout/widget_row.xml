<?xml version="1.0" encoding="utf-8"?>
<!-- یک ردیف نماد به شکل کارت: (راست) LED + نام + کد/حجم | نمودار | (چپ) قیمت/واحد + تغییر -->
<!-- فقط کلاس‌های مجاز RemoteViews — بدون فونت سفارشی -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layoutDirection="rtl"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/row_led"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@null"
                android:src="@drawable/led_gray" />

            <TextView
                android:id="@+id/row_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="-"
                android:textColor="#F1F5F9"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#8B9AB1"
            android:textSize="9.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_spark"
        android:layout_width="52dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@android:color/transparent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:minWidth="86dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="—"
            android:textColor="#F1F5F9"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:text=""
            android:textColor="#8B9AB1"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/row_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:background="@drawable/badge_flat"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="—"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
